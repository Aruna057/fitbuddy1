# ==============================================================================
# FITBUDDY – AI FITNESS PLAN GENERATOR ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Models (Supports current Google GenAI SDK identifiers)
# Recommended defaults: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_WORKOUT_MODEL=gemini-2.5-flash
GEMINI_TIP_MODEL=gemini-2.5-flash

# SQLite Database Connection String
DATABASE_URL=sqlite:///./fitbuddy.db

# Admin Dashboard Session Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_secure_password

# Starlette Session Secret Key
SECRET_KEY=replace-with-a-random-secret-key-32-chars-minimum

# Application Environment (development / production / testing)
APP_ENV=development
